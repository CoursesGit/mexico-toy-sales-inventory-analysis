	column 库存状态显示 = SWITCH(inventory_fact[Inventory_Status], "Active Stockout","缺货", "Critical","高风险", "Low Stock","低库存", "Healthy","健康", "Overstock","库存过量", "Dormant / No Recent Sales","近期无销量", inventory_fact[Inventory_Status])
		dataType: string
		lineageTag: 62fdd9a0-547c-4dcf-a74b-4b1ede9f0e51
		summarizeBy: none
		sortByColumn: 库存状态顺序

	column 库存状态顺序 = SWITCH(inventory_fact[Inventory_Status], "Active Stockout",1, "Critical",2, "Low Stock",3, "Healthy",4, "Overstock",5, "Dormant / No Recent Sales",6, 99)
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 7226353d-1add-4ca7-a4c7-4c406445808e
		summarizeBy: none

	column 风险优先级排名 = RANKX(FILTER(ALL(inventory_fact), inventory_fact[Analytical_Priority] = "P1"), IF(inventory_fact[Inventory_Status] = "Active Stockout", 1000000000000, 0) + inventory_fact[GP_Opportunity_Exposure_Base] * 1000000 - inventory_fact[Store_ID] * 1000 - inventory_fact[Product_ID],, DESC, SKIP)
		isHidden
		formatString: 0
		lineageTag: e7bfa5bb-ff16-4f78-b80b-12a79bc65901

	partition inventory_fact = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(DataRootPath & "inventory_fact.csv"),[Delimiter=",",Encoding=65001,QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source,[PromoteAllScalars=true]),
					Types = Table.TransformColumnTypes(Headers,{{"Store_ID",Int64.Type},{"Product_ID",Int64.Type},{"Stock_On_Hand",Int64.Type},{"Inventory_Cost",type number},{"Inventory_Retail_Value",type number},{"Recent_90D_Units",Int64.Type},{"Avg_Daily_Demand_90D",type number},{"Days_Cover_90D",type number},{"Inventory_Status",type text},{"Analytical_Priority",type text},{"Need_Qty_Base",Int64.Type},{"Sales_Opportunity_Exposure_Base",type number},{"GP_Opportunity_Exposure_Base",type number},{"Donor_Excess_Base",Int64.Type}})
				in Types

