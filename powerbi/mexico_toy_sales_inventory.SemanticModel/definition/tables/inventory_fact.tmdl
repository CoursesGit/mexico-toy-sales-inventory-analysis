table inventory_fact
	lineageTag: c6730f5b-9f67-429e-be9f-c456fd6fda42

	measure 'Total Stock Units' = SUM(inventory_fact[Stock_On_Hand])
		formatString: #,##0
		lineageTag: 61166ac0-b686-41f1-bcdd-ceac2dced5f4

	measure 'Inventory Retail Value' = SUM(inventory_fact[Inventory_Retail_Value])
		formatString: #,##0
		lineageTag: a3312e91-5df4-42c0-a200-dcc4367a7da8

	measure 'Inventory Cost' = SUM(inventory_fact[Inventory_Cost])
		formatString: #,##0.00
		lineageTag: 92d31ef2-2f1d-4add-80c8-a46cda9002e4

	measure 'Active Stockout Count' = CALCULATE(COUNTROWS(inventory_fact),inventory_fact[Inventory_Status]="Active Stockout")
		formatString: #,##0
		lineageTag: c8d26c32-76df-4209-b553-fab930d09c50

	measure 'Critical Count' = CALCULATE(COUNTROWS(inventory_fact),inventory_fact[Inventory_Status]="Critical")
		formatString: #,##0
		lineageTag: 375b7718-2ea6-47c7-ab86-7bc2818b3645

	measure 'Low Stock Count' = CALCULATE(COUNTROWS(inventory_fact),inventory_fact[Inventory_Status]="Low Stock")
		formatString: #,##0
		lineageTag: 96749c3b-e5d6-48f7-ad59-c9755e5523c5

	measure 'Overstock Count' = CALCULATE(COUNTROWS(inventory_fact),inventory_fact[Inventory_Status]="Overstock")
		formatString: #,##0
		lineageTag: 0c54d0d5-fb79-4e7a-a358-c33ca2a307d0

	measure 'Dormant Count' = CALCULATE(COUNTROWS(inventory_fact),inventory_fact[Inventory_Status]="Dormant / No Recent Sales")
		formatString: #,##0
		lineageTag: c2b6f855-82ef-4107-87f9-c0fbdc44058c

	measure 'Dormant Inventory Cost' = CALCULATE([Inventory Cost],inventory_fact[Inventory_Status]="Dormant / No Recent Sales")
		formatString: #,##0.00
		lineageTag: a164afae-c3f2-4d40-afe7-31f961d64840

	measure 'P1 Risk Count' = CALCULATE(COUNTROWS(inventory_fact),inventory_fact[Analytical_Priority]="P1")
		formatString: #,##0
		lineageTag: a0bdf436-7f79-4867-8e9c-ebb44b00585e

	measure 'Base Sales Opportunity' = SUM(inventory_fact[Sales_Opportunity_Exposure_Base])
		formatString: #,##0
		lineageTag: 2f573a3d-e1b3-4f72-87bf-152bbfd73da1

	measure 'Base GP Opportunity' = SUM(inventory_fact[GP_Opportunity_Exposure_Base])
		formatString: #,##0.00
		lineageTag: ff5c2a4a-3e57-42e1-b9f4-7dfec71d0348

	measure 'Store-SKU Count' = COUNTROWS(inventory_fact)
		formatString: #,##0
		lineageTag: d95f02d9-41c4-445d-910a-f9ff34826fbd

	measure 'Risk Priority Rank' = VAR CurrentScore=IF(MAX(inventory_fact[Inventory_Status])="Active Stockout",1000000000,0)+MAX(inventory_fact[GP_Opportunity_Exposure_Base]) RETURN RANKX(ALLSELECTED(inventory_fact[Store_ID],inventory_fact[Product_ID]),CALCULATE(IF(MAX(inventory_fact[Inventory_Status])="Active Stockout",1000000000,0)+MAX(inventory_fact[GP_Opportunity_Exposure_Base])),CurrentScore,DESC,DENSE)
		formatString: 0
		lineageTag: a5cc4789-226a-4f57-8d0a-b6228edefac6

	measure 'P1 GP Opportunity' = CALCULATE([Base GP Opportunity], inventory_fact[Analytical_Priority]="P1")
		formatString: #,##0.00
		lineageTag: 39eb93ba-ce2e-4257-8254-bbd3ddf0a4c7

