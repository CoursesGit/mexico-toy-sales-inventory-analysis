relationship rel_sales_fact_products
	fromColumn: sales_fact.Product_ID
	toColumn: products.Product_ID

relationship rel_sales_fact_stores
	fromColumn: sales_fact.Store_ID
	toColumn: stores.Store_ID

relationship rel_inventory_fact_products
	fromColumn: inventory_fact.Product_ID
	toColumn: products.Product_ID

relationship rel_inventory_fact_stores
	fromColumn: inventory_fact.Store_ID
	toColumn: stores.Store_ID

relationship rel_inventory_actions_products
	fromColumn: inventory_actions.Product_ID
	toColumn: products.Product_ID

relationship rel_inventory_actions_stores
	fromColumn: inventory_actions.Store_ID
	toColumn: stores.Store_ID

relationship rel_inventory_exceptions_products
	fromColumn: inventory_exceptions.Product_ID
	toColumn: products.Product_ID

relationship rel_inventory_exceptions_stores
	fromColumn: inventory_exceptions.Store_ID
	toColumn: stores.Store_ID

relationship rel_sales_fact_DateTable
	fromColumn: sales_fact.Date
	toColumn: DateTable.Date

